# =============================================================================
# LAPATO - variaveis de ambiente (12-factor, Engineering Blueprint secao 5)
# Copie para .env. NUNCA versione o .env nem qualquer segredo real.
# Em producao estes valores vem do secret manager, nao de arquivo.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- Dominio e TLS ---------------------------------------------------------
# Producao: o dominio publico. O Caddy emite e renova o certificado sozinho.
#   SITE_ADDRESS=app.lapato.com.br
# Desenvolvimento: deixe vazio para servir em :80 sem TLS.
SITE_ADDRESS=
# E-mail que o Let's Encrypt usa para avisos de expiracao. Obrigatorio em producao.
ACME_EMAIL=

# --- API -------------------------------------------------------------------
API_PORT=3000
# Quanto do caminho sobra quando o request chega no processo. O navegador sempre
# chama /api/v1/...; um proxy que roteia por caminho pode consumir o /api antes.
#   Caddy do compose local (repassa tudo): api/v1
#   Coolify/Traefik roteando por caminho:  v1
API_GLOBAL_PREFIX=api/v1
# Origens permitidas para o front (separadas por virgula).
# Como front e API compartilham o host, isto so importa em desenvolvimento,
# onde o Vite roda numa porta separada. Em producao: https://app.lapato.com.br
API_CORS_ORIGINS=http://localhost:5173

# --- Banco de dados --------------------------------------------------------
# Usuario da aplicacao: NAO pode ter BYPASSRLS (Blueprint secao 7)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lapato
POSTGRES_USER=lapato_app
# Deixe vazio e preencha no seu .env local; em producao vem do secret manager.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://lapato_app:SENHA@postgres:5432/lapato

# Usuario dono do schema, usado apenas para migrations
POSTGRES_MIGRATOR_USER=lapato_owner
POSTGRES_MIGRATOR_PASSWORD=
DATABASE_MIGRATION_URL=postgres://lapato_owner:SENHA@postgres:5432/lapato

# --- Redis: ainda NAO existe ------------------------------------------------
# Redis (filas) esta listado aqui e no Compose, mas nenhuma linha de codigo o
# le - nao esta nas dependencias nem no schema de validacao de `env.ts`.
# Configura-lo hoje nao muda comportamento nenhum. Volta quando as filas do
# M07 forem implementadas.

# --- Armazenamento de arquivos ----------------------------------------------
# `local` grava em disco e nao exige credencial - e o padrao de dev e teste,
# no mesmo espirito do COPILOT_PROVIDER=stub. Em producao use `r2` com as
# quatro credenciais da Cloudflare abaixo. Guarda o PDF do laudo (M11) hoje;
# o M16 (imagens) reaproveita o mesmo bucket depois.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage-local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Sessao e autenticacao -------------------------------------------------
# Obrigatorio, minimo 32 caracteres. Gere com: openssl rand -hex 32
# Deixado vazio de proposito: arquivo de exemplo nao carrega valor que pareca
# segredo - isso dispara scanner de segredos e ensina o habito errado.
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=lapato_session
# Em producao PRECISA ser true. A aplicacao recusa subir com NODE_ENV=production
# e este valor em false: sessao sem Secure trafega em claro.
SESSION_COOKIE_SECURE=false
# Emissor exibido nos apps de TOTP
MFA_ISSUER=LAPATO

# --- Protecoes de fluxo (Blueprint secao 6) --------------------------------
# Teto por IP na janela. O geral e generoso (navegar dispara varias chamadas);
# o de entrada vale para login, MFA e validacao publica de laudo.
RATE_LIMIT_JANELA_SEGUNDOS=60
RATE_LIMIT_REQUISICOES=300
RATE_LIMIT_LOGIN=10

# Quantos proxies existem entre o cliente e a API.
# 0 = nenhum (padrao, e o caso do compose local).
# 1 = atras do Traefik do Coolify. SEM isto, o IP de todo request e o do proxy:
#     o rate limit vira um balde unico e o audit_log grava o proxy no lugar de
#     quem agiu. Nao aumente sem ter mesmo essa quantidade de saltos - o excesso
#     deixa o cliente forjar o proprio IP pelo X-Forwarded-For.
TRUST_PROXY=0

# --- Schema do banco (ADR 0010) --------------------------------------------
# bloquear (padrao) = a API recusa subir se houver migration pendente. Deploy
#                     com migration esquecida falha no deploy, nao no usuario.
# avisar            = sobe e loga. Valvula de emergencia; nao deixe ligado.
MIGRACOES_PENDENTES=bloquear

# --- Inteligencia artificial (Modulo 17) -----------------------------------
# stub  = sem LLM, apenas Guardian deterministico (padrao desta fase)
# claude = provedor real (fase posterior)
COPILOT_PROVIDER=stub
# ANTHROPIC_API_KEY=

# --- Front web -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Base publica do front - usada para montar a URL que o QR Code do laudo
# aponta (M11 secao 88).
WEB_PUBLIC_URL=http://localhost:5173
