# =============================================================================
# API do LAPATO - build multi-stage, imagem enxuta, usuario nao-root
# (Engineering Blueprint secao 5)
# =============================================================================

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

# --- deps: instala com o lockfile, aproveitando cache de camada -------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @lapato/api...

# --- build ------------------------------------------------------------------
FROM base AS build
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages ./packages
COPY --from=deps /repo/apps ./apps
COPY . .
RUN pnpm --filter @lapato/api... build \
 && pnpm deploy --filter @lapato/api --prod --legacy /app

# --- runtime ----------------------------------------------------------------
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Usuario nao-root dedicado
RUN addgroup -g 1001 -S lapato && adduser -u 1001 -S lapato -G lapato

COPY --from=build --chown=lapato:lapato /app ./

USER lapato
EXPOSE 3000

# O caminho vem das MESMAS variaveis que a aplicacao le, e nao fixo.
#
# Com o caminho fixo, mudar `API_GLOBAL_PREFIX` deixava o healthcheck apontando
# para uma rota que passou a nao existir: a aplicacao subia perfeita, o container
# era declarado doente e o orquestrador revertia o deploy. Configuracao valida,
# deploy impossivel - e o log so dizia "not healthy".
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const p=(process.env.API_GLOBAL_PREFIX||'api/v1').replace(/^\\/+|\\/+$/g,'');const port=process.env.API_PORT||3000;fetch(`http://localhost:${port}/${p}/health`).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "dist/main.js"]
