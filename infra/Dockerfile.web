# =============================================================================
# Front web do LAPATO - build Vite, servido por nginx como estatico
# (Engineering Blueprint secao 5)
# =============================================================================

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/design-tokens/package.json packages/design-tokens/
COPY packages/ui/package.json packages/ui/
COPY packages/api-client/package.json packages/api-client/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @lapato/web...

FROM base AS build
# Os tres COPY sao necessarios, e nao um so.
#
# Num workspace pnpm as dependencias de cada pacote ficam em
# `packages/<nome>/node_modules`, com links para o store da raiz - nao apenas em
# `/repo/node_modules`. Copiar so a raiz deixa `packages/shared` sem o proprio
# `node_modules`, e o `tsc` falha com "Cannot find module 'zod'".
#
# O `COPY . .` depois sobrepoe o codigo-fonte por cima, preservando esses
# diretorios porque `.dockerignore` exclui `node_modules` do contexto.
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages ./packages
COPY --from=deps /repo/apps ./apps
COPY . .
# A SPA fala com a API pelo mesmo host - por isso o caminho e relativo.
ENV VITE_API_BASE_URL=/api/v1
RUN pnpm --filter @lapato/web... build

FROM nginx:1.27-alpine AS runtime
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx-seguranca.conf /etc/nginx/seguranca.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html

# nginx:alpine ja traz o usuario nginx; roda sem root nos workers.
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
