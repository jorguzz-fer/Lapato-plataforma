{
  "name": "lapato",
  "version": "0.1.0",
  "private": true,
  "description": "LAPATO - Sistema Integrado de Gestao Anatomopatologica Veterinaria",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @lapato/db generate",
    "db:migrate": "pnpm --filter @lapato/db migrate",
    "db:seed": "pnpm --filter @lapato/db seed",
    "openapi:generate": "pnpm --filter @lapato/api openapi:generate && pnpm --filter @lapato/api-client generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "//": "Overrides de seguranca: dependencias transitivas que os pacotes pais ainda nao atualizaram. Revisar a cada bump de NestJS e Vitest; remover assim que o pai passar a exigir a versao corrigida.",
    "overrides": {
      "vite": "^6.4.3",
      "js-yaml": "^4.3.1"
    }
  }
}
