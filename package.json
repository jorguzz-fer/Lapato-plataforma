{
  "name": "lapato",
  "version": "0.1.0",
  "private": true,
  "description": "LAPATO - Sistema Integrado de Gestao Anatomopatologica Veterinaria",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @lapato/db generate",
    "db:migrate": "pnpm --filter @lapato/db migrate",
    "db:seed": "pnpm --filter @lapato/db seed",
    "db:provision": "pnpm --filter @lapato/db provision",
    "db:redefinir-senha": "pnpm --filter @lapato/db redefinir-senha",
    "openapi:generate": "pnpm --filter @lapato/api openapi:generate && pnpm --filter @lapato/api-client generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "//": "Overrides de seguranca: dependencias transitivas que os pacotes pais ainda nao atualizaram. `qs` e `esbuild` entraram na auditoria de 23/08/2026 (ver docs/auditoria-seguranca.md); `multer` (DoS por nome de campo e por upload abortado, GHSA-wc9g-mqfw-jrwm, GHSA-qfvm-cv95-jqjf, GHSA-535w-7cp7-47q4) e o bump do `js-yaml` (GHSA-2883-xcg3-v3hh) em 09/09/2026. Revisar a cada bump de NestJS, Vite e Vitest; remover assim que o pai passar a exigir a versao corrigida.",
    "overrides": {
      "vite": "^6.4.3",
      "js-yaml": "^4.3.2",
      "multer": "^2.3.0",
      "qs": "^6.15.2",
      "esbuild": "^0.25.0"
    }
  }
}
