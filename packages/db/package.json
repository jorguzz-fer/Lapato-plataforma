{
  "name": "@lapato/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "generate": "pnpm build && drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "provision": "tsx src/cli/provision.ts",
    "redefinir-senha": "tsx src/cli/redefinir-senha.ts",
    "vincular-lotes": "tsx src/cli/vincular-lotes.ts",
    "sincronizar-perfis": "tsx src/cli/sincronizar-perfis.ts",
    "sincronizar-workflows": "tsx src/cli/sincronizar-workflows.ts",
    "popular-equipe": "tsx src/cli/popular-equipe.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@lapato/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "otpauth": "^9.3.6",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
